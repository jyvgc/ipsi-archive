rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function em() { return request.auth.token.email.lower(); }
    function allowed() { return request.auth != null && firestore.exists(/databases/(default)/documents/allowedUsers/$(em())); }
    function admin() { return allowed() && firestore.get(/databases/(default)/documents/allowedUsers/$(em())).data.role == 'admin'; }

    match /files/{id}/{name} {
      allow read: if allowed();
      allow create, update: if admin() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if admin();
    }
  }
}
